<Protocol xmlns="http://www.skyline.be/protocol">
	<Name>Exercise HTTP CoinMarketCap Emir</Name>
	<Description>Exercise HTTP CoinMarketCap DataMiner connector</Description>
	<Version>1.0.0.1</Version>
	<IntegrationID>DMS-DRV-000</IntegrationID>
	<Provider>Skyline Communications</Provider>
	<Vendor>CoinMarketCap</Vendor>
	<VendorOID>1.3.6.1.4.1.8813.2.00</VendorOID>
	<DeviceOID>000</DeviceOID>
	<ElementType>Crypto Currency Tracker</ElementType>
	<Type relativeTimers="true">http</Type>
	<Display defaultPage="General" pageOrder="General" wideColumnPages=""/>
	<SNMP includepages="true">auto</SNMP>

	<Compliancies>
		<CassandraReady>true</CassandraReady>
		<MinimumRequiredVersion>10.3.0.0 - 12752</MinimumRequiredVersion>
	</Compliancies>

	<Params>
		<Param id="2">
			<Name>AfterStartup</Name>
			<Description>After Startup</Description>
			<Type>dummy</Type>
		</Param>
		<Param id="3" trending="false">
			<Name>HttpResponseCodeLatestListings</Name>
			<Description>HTTP Response</Description>
			<Type>read</Type>
			<Information>
			</Information>
			<Interprete>
				<RawType>other</RawType>
				<Type>string</Type>
				<LengthType>next param</LengthType>
			</Interprete>
			<Display>
				<RTDisplay>true</RTDisplay>
				<Positions>
					<Position>
						<Page>General</Page>
						<Column>0</Column>
						<Row>0</Row>
					</Position>
				</Positions>
			</Display>
			<Measurement>
				<Type>string</Type>
			</Measurement>
		</Param>
		<Param id="4" trending="false">
			<Name>JsonResponse</Name>
			<Description>Json Response</Description>
			<Type>read</Type>
			<Information>
			</Information>
			<Interprete>
				<RawType>other</RawType>
				<Type>string</Type>
				<LengthType>next param</LengthType>
			</Interprete>
			<Display>
				<RTDisplay>true</RTDisplay>
				<Positions>
					<Position>
						<Page>General</Page>
						<Column>0</Column>
						<Row>1</Row>
					</Position>
				</Positions>
			</Display>
			<Measurement>
				<Type lines="10">string</Type>
			</Measurement>
		</Param>
		<Param id="5" trending="false">
			<Name>APIKey</Name>
			<Description>API Key</Description>
			<Type>read</Type>
			<Information>
			</Information>
			<Interprete>
				<RawType>other</RawType>
				<Type>string</Type>
				<LengthType>next param</LengthType>
				<DefaultValue>Bearer jWgYFWyQzYAR9ZAm0mvESEKBeerEYw3rYwVEOUvm2Y0=</DefaultValue>
			</Interprete>
			<Display>
				<RTDisplay>false</RTDisplay>
			</Display>
			<Measurement>
				<Type>string</Type>
			</Measurement>
		</Param>
		<Param id="6">
			<Name>GetData</Name>
			<Type>write</Type>
			<Information>
			</Information>
			<Interprete>
				<RawType>other</RawType>
				<Type>string</Type>
				<LengthType>next param</LengthType>
			</Interprete>
			<Display>
				<RTDisplay>true</RTDisplay>
				<Positions>
					<Position>
						<Page>General</Page>
						<Column>0</Column>
						<Row>2</Row>
					</Position>
				</Positions>
			</Display>
			<Measurement>
				<Type width="110">button</Type>
				<Discreets>
					<Discreet>
						<Display>Get Data</Display>
						<Value>Get Data</Value>
					</Discreet>
				</Discreets>
			</Measurement>
		</Param>
	</Params>

	<QActions>
		<QAction id="1" name="Precompiled Code" encoding="csharp" options="precompile" />
		<QAction id="2" name="After Startup" encoding="csharp" triggers="2" />
	</QActions>

	<HTTP>
		<Session id="1" name="Get Latest Listings">
			<Connection id="1">
				<Request verb="GET" url="/api/custom/coinmarketcap?content=latestlistings">
					<Headers>
						<Header key="Authorization" pid="5"></Header>
					</Headers>
				</Request>
				<Response statusCode="3">
					<Content pid="4"></Content>
				</Response>
			</Connection>
		</Session>
		<Session id="2" name="Get Categories">
			<Connection id="1">
				<Request verb="GET" url="/api/custom/coinmarketcap?content=categories">
					<Headers>
						<Header key="Authorization" pid="5"></Header>
					</Headers>
				</Request>
				<Response statusCode="3">
					<Content pid="4"></Content>
				</Response>
			</Connection>
		</Session>
	</HTTP>

	<Groups>
		<Group id="2">
			<Name>After Startup</Name>
			<Description>After Startup</Description>
			<Type>poll action</Type>
			<Content>
				<Action>2</Action>
			</Content>
		</Group>
		<Group id="3">
			<Name>Latest Listings</Name>
			<Description>Latest Listings</Description>
			<Type>poll</Type>
			<Content>
				<Session>1</Session>
			</Content>
		</Group>
		<Group id="4">
			<Name>Categories</Name>
			<Description>Categories</Description>
			<Type>poll</Type>
			<Content>
				<Session>2</Session>
			</Content>
		</Group>
	</Groups>

	<Triggers>
		<Trigger id="1">
			<Name>After Startup</Name>
			<On>protocol</On>
			<Time>after startup</Time>
			<Type>action</Type>
			<Content>
				<Id>1</Id>
			</Content>
		</Trigger>
		<Trigger id="2">
			<Name>On get params</Name>
			<On id="6">parameter</On>
			<Time>change</Time>
			<Type>action</Type>
			<Content>
				<Id>4</Id>
			</Content>
		</Trigger>
	</Triggers>

	<Actions>
		<Action id="1">
			<Name>After Startup Group</Name>
			<On id="2">group</On>
			<Type>execute next</Type>
		</Action>
		<Action id="2">
			<Name>After Startup QAction</Name>
			<On id="2">parameter</On>
			<Type>run actions</Type>
		</Action>
		<Action id="3">
			<Name>Execute Group Latest Listings</Name>
			<On id="3">group</On>
			<Type>execute one now</Type>
		</Action>
		<Action id="4">
			<Name>Execute Group Categories</Name>
			<On id="4">group</On>
			<Type>execute one now</Type>
		</Action>
	</Actions>

	<Timers>
		<Timer id="1">
			<Name>Fast Timer (10s)</Name>
			<Time initial="true">10000</Time>
			<Interval>75</Interval>
			<Content>
			</Content>
		</Timer>
		<Timer id="2">
			<Name>Medium Timer (1m)</Name>
			<Time initial="true" dataDisplay="30000">60000</Time>
			<Interval>75</Interval>
			<Content>
			</Content>
		</Timer>
		<Timer id="3">
			<Name>Slow Timer (1h)</Name>
			<Time initial="true">3600000</Time>
			<Interval>75</Interval>
			<Content>
			</Content>
		</Timer>
	</Timers>

