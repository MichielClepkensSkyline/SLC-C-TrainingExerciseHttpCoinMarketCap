	<QActions>
		<QAction id="1" name="Precompiled Code" encoding="csharp" options="precompile" />
		<QAction id="2" name="After Startup" encoding="csharp" triggers="2" />
		<QAction id="3" name="Process Latest Listings Response" encoding="csharp" triggers="11"/>
	</QActions>

	<HTTP>
		<Session id="1" name="Get Latest Listings on Coin Market">
			<Connection id="1" name="Get Latest Listings on Coin Market">
				<Request verb="GET" url="api/custom/coinmarketcap?content=latestlistings">
					<Headers>
						<Header key="Authorization" pid="3"/>
					</Headers>
				</Request>
				<Response statusCode="10">
					<Content pid="11"></Content>
				</Response>
			</Connection>
		</Session>
		<Session id="2" name="Get Categories on Coin Market">
			<Connection id="2" name="Get Categories on Coin Market">
				<Request verb="GET" url="/api/custom/coinmarketcap?content=categories">
					<Headers>
						<Header key="Authorization" pid="3"/>
					</Headers>
				</Request>
				<Response statusCode="20">
					<Content pid="21"></Content>
				</Response>
			</Connection>
		</Session>
		<Session id="3" name="Get Latest Quotes on Coin Market">
			<Connection id="3" name="Get Latest Quotes on Coin Market">
				<Request verb="GET" url="/api/custom/coinmarketcap?content=latestquotes">
					<Headers>
						<Header key="Authorization" pid="3"/>
					</Headers>
				</Request>
				<Response statusCode="30">
					<Content pid="31"></Content>
				</Response>
			</Connection>
		</Session>
	</HTTP>

	<Groups>
		<Group id="2">
			<Name>After Startup</Name>
			<Description>After Startup</Description>
			<Type>poll action</Type>
			<Content>
				<Action>2</Action>
			</Content>
		</Group>
		<Group id="4">
			<Name>HTTP request</Name>
			<Description>This group sends an HTTP request</Description>
			<Type>poll</Type>
			<Content>
				<Session>1</Session>
			</Content>
		</Group>
		<Group id="5">
			<Name>HTTP request Categories</Name>
			<Description>HTTP request Categories</Description>
			<Type>poll</Type>
			<Content>
				<Session>2</Session>
			</Content>
		</Group>
		<Group id="6">
			<Name>HTTP request Latest Quotes</Name>
			<Description>HTTP request Latest Quotes</Description>
			<Type>poll</Type>
			<Content>
				<Session>3</Session>
			</Content>
		</Group>
	</Groups>

	<Triggers>
		<Trigger id="1">
			<Name>After Startup</Name>
			<On>protocol</On>
			<Time>after startup</Time>
			<Type>action</Type>
			<Content>
				<Id>1</Id>
			</Content>
		</Trigger>
		<Trigger id="4">
			<Name>Send HTTP Request</Name>
			<On id="4">parameter</On>
			<Time>change</Time>
			<Type>action</Type>
			<Content>
				<Id>4</Id>
				<Id>5</Id>
				<Id>6</Id>
			</Content>
		</Trigger>
	</Triggers>

	<Actions>
		<Action id="1">
			<Name>After Startup Group</Name>
			<On id="2">group</On>
			<Type>execute next</Type>
		</Action>
		<Action id="2">
			<Name>After Startup QAction</Name>
			<On id="2">parameter</On>
			<Type>run actions</Type>
		</Action>
		<Action id="4">
			<Name>Execute HTTP Group</Name>
			<On id="4">group</On>
			<Type>execute next</Type>
		</Action>
		<Action id="5">
			<Name>Execute HTTP Group Categories</Name>
			<On id="5">group</On>
			<Type>execute next</Type>
		</Action>
		<Action id="6">
			<Name>Execute HTTP Group Latest Quotes</Name>
			<On id="6">group</On>
			<Type>execute next</Type>
		</Action>
	</Actions>

	<Timers>
		<Timer id="1">
			<Name>Fast Timer (10s)</Name>
			<Time initial="true">10000</Time>
			<Interval>75</Interval>
			<Content>
			</Content>
		</Timer>
		<Timer id="2">
			<Name>Medium Timer (1m)</Name>
			<Time initial="true" dataDisplay="30000">60000</Time>
			<Interval>75</Interval>
			<Content>
			</Content>
		</Timer>
		<Timer id="3">
			<Name>Slow Timer (1h)</Name>
			<Time initial="true">3600000</Time>
			<Interval>75</Interval>
			<Content>
			</Content>
		</Timer>
	</Timers>

