		<BusAddress>
			<Disabled>true</Disabled>
		</BusAddress>
		<IPport>
			<DefaultValue>443</DefaultValue>
			<Disabled>true</Disabled>
		</IPport>
		<Type>
			<DefaultValue>ip</DefaultValue>
		</Type>
		<PortTypeUDP>
			<Disabled>true</Disabled>
		</PortTypeUDP>
		<PortTypeSerial>
			<Disabled>true</Disabled>
		</PortTypeSerial>
	</PortSettings>


